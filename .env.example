# Logto (shared Light Rider tenant). Copy to .env.local and fill in.
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_COOKIE_SECRET=
# This app's own origin; every Logto redirect URI is built from it.
NEXT_BASE_URL=

# Logto Management API (M2M app): user lookups by email for credit transfers,
# invites and the account page.
LOGTO_MANAGEMENT_ENDPOINT=
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=

# Supabase Storage for avatars. Same project and bucket as the Quantum and
# Entropy apps, so a user's avatar (<logtoUserId>/avatar.webp) is shared.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=

# The shared Light Rider database: the SAME values as the Quantum app for this
# environment. Cloud reads and writes Quantum's public schema; Quantum owns the
# migrations (never run `prisma migrate` from this repo).
DATABASE_URL=
DIRECT_URL=

# Stripe. Server-side customer creation (first billing touch) and the read-only
# payment method on Payment & History. No checkout or portal in Cloud yet.
STRIPE_SECRET_KEY=

# Invite emails (Postmark) and where invite links point. Set INVITE_BASE_URL
# to this app's stable production origin in production.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
INVITE_BASE_URL=

# Product sites the solution cards link to (origins, no trailing slash).
NEXT_PUBLIC_QUANTUM_URL=
NEXT_PUBLIC_ENTROPY_URL=
NEXT_PUBLIC_PQC_URL=
